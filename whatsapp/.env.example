# Copy to .env (git-ignored) or set as Azure App Service application settings. Never commit real values.
PROVIDER=twilio            # twilio | meta
PUBLIC_BASE_URL=https://your-app.azurewebsites.net   # used to verify Twilio signatures

# Twilio Sandbox
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=whatsapp:+14155238886

# Meta Cloud API
META_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=pick-any-string
META_APP_SECRET=
